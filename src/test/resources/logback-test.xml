<?xml version="1.0" encoding="UTF-8"?>
<!-- Without this, logback falls back to DEBUG-on-root for the plain (non-Spring) unit tests and
     buries the test results in RestTemplate wire logs. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.example.feishuproxy" level="WARN"/>
</configuration>
